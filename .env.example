# =========================================================================
# PLANTILLA DE CONFIGURACIÓN LOCAL - RELLENAR CON DATOS REALES EN EL .ENV
# =========================================================================

# Firebase Console -> Configuración del proyecto -> General -> ID del proyecto
FIREBASE_PROJECT_ID="tu-proyecto-id-aqui"

# Firebase Console -> Configuración del proyecto -> General -> "Clave de API web"
FIREBASE_WEB_API_KEY="tu-clave-de-api-web-aqui"

# Firebase Console -> Configuración del proyecto -> Cuentas de servicio -> Correo del cliente
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@tu-proyecto.iam.gserviceaccount.com"

# Firebase Console -> Configuración del proyecto -> Cuentas de servicio -> "Generar nueva clave privada"
# NOTA (archivo .env local): una sola línea, entre comillas dobles y saltos escritos como \n
# NOTA (Vercel y otros paneles): pega SOLO el valor (una línea con \n o con saltos reales, SIN las comillas de fuera)
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBgkqhkiG9w0BAQEFAASCBKcwggSjAgEAAoIBAQDF6RjX7bsw2jVK\n...tu...clave...privada...aqui...\n-----END PRIVATE KEY-----\n"
